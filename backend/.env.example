# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3001

# Database
DATABASE_URL=postgresql://pushnotify:pushnotify_password@localhost:5432/pushnotify

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-a-long-random-string
JWT_EXPIRES_IN=30d

# CORS Configuration
CORS_ORIGIN=*
